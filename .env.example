APP_PORT=3010

# Seasonal theme (falling snow/leaves/petals + landscape). On by default.
# Set to "off" to disable it for everyone (users can still toggle in Settings).
SUBPAGE_SEASONAL=on

# Optional: force the seasonal month by number 1-12 (1=Jan … 12=Dec) instead of
# the real date — e.g. SUBPAGE_FORCE_MONTH=12 shows December (winter/snow).
# Empty = follow the real calendar.
SUBPAGE_FORCE_MONTH=

# Self-host the Telegram WebApp SDK. Off by default: the script is loaded from
# telegram.org. If your users open the subpage without a VPN, telegram.org is
# blocked, the script can't load and the page hangs — set this to "on" to serve the
# SDK from your own domain (/assets/telegram-web-app.js) instead. The <script> tag
# stays either way, so Telegram Mini App integration keeps working.
SUBPAGE_TG_SELFHOST=off

### Remnawave Panel URL, e.g. http://remnawave:3000 or https://panel.example.com
REMNAWAVE_PANEL_URL=http://remnawave:3000

### API token — create in Remnawave Dashboard → Settings → API Tokens
REMNAWAVE_API_TOKEN=

# Serve at a custom root path, e.g. CUSTOM_SUB_PREFIX=sub  (no leading/trailing /)
CUSTOM_SUB_PREFIX=

# Optional: show the "Devices" card (actual / HWID limit) on the page.
# This makes SEPARATE admin requests to the panel to read the per-user HWID
# limit and device count, so REMNAWAVE_API_TOKEN must be allowed to read
# users and HWID devices. off by default. Set to "on" to enable.
HWID_DEVICES=off

# Optional: "Caddy with security" / "Tiny Auth" — sent as X-Api-Key to the panel
CADDY_AUTH_API_TOKEN=

# Optional: panel behind eGames reverse-proxy (nginx cookie gate) — sent as Cookie: <value>
# to the panel. Take the name=value from the panel access link:
#   https://panel.example.com/auth/login?NAME=VALUE   →   EGAMES_COOKIE=NAME=VALUE
EGAMES_COOKIE=

# Optional: Cloudflare Zero Trust
CLOUDFLARE_ZERO_TRUST_CLIENT_ID=""
CLOUDFLARE_ZERO_TRUST_CLIENT_SECRET=""

# Optional: Marzban legacy links
MARZBAN_LEGACY_LINK_ENABLED=false
MARZBAN_LEGACY_SECRET_KEY=
MARZBAN_LEGACY_SUBSCRIPTION_VALID_FROM=
