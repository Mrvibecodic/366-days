APP_PORT=3010

# Seasonal theme (falling snow/leaves/petals + landscape).
# "on" (default) - background and animation; phones get a lighter animation and
#   fall back to the still background if they cannot keep up;
# "static" - background and landscape only, nothing moves;
# "full" - full animation everywhere, no automatic fallback;
# "off" - disabled for everyone (users can still toggle in Settings).
SUBPAGE_SEASONAL=on

# Optional: force the seasonal month by number 1-12 (1=Jan … 12=Dec) instead of
# the real date — e.g. SUBPAGE_FORCE_MONTH=12 shows December (winter/snow).
# Empty = follow the real calendar.
SUBPAGE_FORCE_MONTH=

# How apps are shown when a platform has more than one:
# "list" (default) - apps as rows, the chosen one is open with its steps;
# "tiles" - apps as a row of tiles. With a single app there is no chooser.
SUBPAGE_APPS_VIEW=list

# How the platform chooser looks:
# "list" (default) - a column, the visitor picks a device first;
# "tiles" - the same, but as tiles;
# "bar" - a strip above the guide, as in 2.0.
SUBPAGE_PLATFORMS_VIEW=list

# What is open on arrival when platforms are shown as a column or tiles:
# "off" (default) - nothing, the visitor's device goes first and is marked;
# "auto" - the guide for the visitor's device is open right away.
SUBPAGE_PLATFORM_OPEN=off

# The big link button: "copy" (default) copies the link at once, QR button next to it;
# "window" opens a window with the link and its QR code.
SUBPAGE_LINK_BUTTON=copy

# Dense subscription block on phones so the first screen fits. "on" by default.
# "off" - the block looks the way it is set in the panel.
SUBPAGE_COMPACT=on

### Remnawave Panel URL, e.g. http://remnawave:3000 or https://panel.example.com
REMNAWAVE_PANEL_URL=http://remnawave:3000

### API token — create in Remnawave Dashboard → Settings → API Tokens
REMNAWAVE_API_TOKEN=

# Serve at a custom root path, e.g. CUSTOM_SUB_PREFIX=sub  (no leading/trailing /)
CUSTOM_SUB_PREFIX=

# Optional: show the "Devices" card (actual / HWID limit) on the page.
# This makes SEPARATE admin requests to the panel to read the per-user HWID
# limit and device count, so REMNAWAVE_API_TOKEN must be allowed to read
# users and HWID devices. off by default. Set to "on" to enable.
HWID_DEVICES=off

# Optional: "Caddy with security" / "Tiny Auth" — sent as X-Api-Key to the panel
CADDY_AUTH_API_TOKEN=

# Optional: panel behind eGames reverse-proxy (nginx cookie gate) — sent as Cookie: <value>
# to the panel. Take the name=value from the panel access link:
#   https://panel.example.com/auth/login?NAME=VALUE   →   EGAMES_COOKIE=NAME=VALUE
EGAMES_COOKIE=

# Optional: Cloudflare Zero Trust
CLOUDFLARE_ZERO_TRUST_CLIENT_ID=""
CLOUDFLARE_ZERO_TRUST_CLIENT_SECRET=""

# Optional: Marzban legacy links
MARZBAN_LEGACY_LINK_ENABLED=false
MARZBAN_LEGACY_SECRET_KEY=
MARZBAN_LEGACY_SUBSCRIPTION_VALID_FROM=
